# ==============================================================================
# TIZGIN — SMART WATER MANAGEMENT PLATFORM (ENVIRONMENT CONFIGURATION)
# ==============================================================================

# 1. SQLite Database Configuration
DATABASE_PATH="./data/tizgin.db"
BACKUP_DIRECTORY="./data/backups"

# 2. Authentication & Session Security
JWT_SECRET="tizgin-super-secret-municipal-water-platform-key-2026"
SESSION_COOKIE_NAME="tizgin_session"
SESSION_EXPIRY_HOURS="168"

# 3. Default Application Locale (uz, kaa, en, ru)
NEXT_PUBLIC_DEFAULT_LOCALE="uz"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. File Storage Configuration
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB="15"

# 5. Groq AI Vision & Smart Water Dispatch Assistant Configuration
AI_VISION_PROVIDER="groq"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"

# 6. Telegram Bot & Notification Configuration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
SMTP_HOST="smtp.tizgin.uz"
SMTP_PORT="587"
SMTP_USER="notifications@tizgin.uz"
SMTP_PASS=""
